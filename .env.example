# Optional public port and canonical enterprise URL.
MOGO_PORT=3000
# Physical Docker volume prefix. Keep this stable after the first startup.
MOGO_VOLUME_PREFIX=mogo
# Official prebuilt images. Override only when using a private registry.
MOGO_IMAGE_REGISTRY=ghcr.io/mogoai
# Pin a release in production, for example v0.1.0. Defaults to latest.
# 本地源码构建建议留空（启动时由构建脚本注入具体 tag，如 git short hash）。
MOGO_VERSION=latest
PUBLIC_BASE_URL=

# ── 网关 TLS（默认启用）──────────────────────────────────────────────────
# 网关默认加载 TLS 侧配置，HTTP(80) 会 301 到 HTTPS（/healthz 例外，供健康检查用）。
# 前置条件：deploy/tls/ 下要有 fullchain.pem + privkey.pem，且**私钥必须 0644**
# ——网关以非 root(UID 10001) 运行，Linux 上 bind mount 保留宿主 uid，0600 会让
# nginx 启动即 `cannot load certificate key ... (13: Permission denied)`。
# 证书不入库；自签做法见 README 的「HTTPS and TLS certificates」或
# deploy/tls/README.md。已有证书放在项目根目录时可跑 `bash deploy/tls/setup-certs.sh`
# 复制并归一化权限。
# 开启 TLS：MOGO_TLS=1
MOGO_TLS=0
MOGO_NGINX_CONF=./deploy/nginx/nginx.conf
# 证书目录，默认 ./deploy/tls。
# MOGO_TLS_CERTS_DIR=./deploy/tls
# 仅本地/内网调试要退回 HTTP 时，改为指向 HTTP 侧配置：
# MOGO_NGINX_CONF=./deploy/docker/nginx.conf

# ── 运行环境 profile：dev（默认）| test | prod ────────────────────────
# 三个环境用 compose profile 固化，启动时指定：./mogo --profile dev up
#   dev   arm64 + 栈内 mongo 容器            （MOGO_DATA_BACKEND=mongo）
#   test  arm64 + 栈内 panweidb 容器          （MOGO_DATA_BACKEND=panweidb）
#   prod  amd64 + 外部 panweidb               （MOGO_DATA_BACKEND=panweidb + PANWEIDB_HOST 指向外部）
# 不指定 --profile 时按本文件推断：MOGO_USE_EXTERNAL_DB=1 -> prod，
# MOGO_DATA_BACKEND=panweidb -> test，其余 -> dev。命令行优先级更高。
# prod 只要求「数据库在外部」：redis / weaviate 仍在栈内，与
# deploy/production 的 x86 交付模板一致；要连外部 redis 再开 MOGO_USE_EXTERNAL_DB=1。
# 容器平台由 profile 决定（dev/test=linux/arm64、prod=linux/amd64）。未显式写
# MOGO_PLATFORM 且宿主架构与目标不符时启动会被拒绝（不会悄悄按宿主架构跑），
# 两种写法二选一：MOGO_PLATFORM=linux/amd64 ./mogo --profile prod up（真实交付），
# 或 MOGO_PLATFORM=linux/arm64 ./mogo --profile prod up（arm64 上演练 prod 拓扑）。
# MOGO_PROFILE=dev
# MOGO_PLATFORM=

# ── 数据后端：mongo（默认）| panweidb ────────────────────────────────
# 切成 panweidb 时，compose 会同时启用 `panweidb` profile，把数据库容器带进
# 拓扑（./mogo up 一条命令即可整栈启动，含数据库）。
# 前置：本地要有 panweidb:3.2.0 镜像（不发布 registry）：
#   docker load -i base-images/images/arm64/panweidb_3.2.0.tar
# 详见 docs/panweidb-compose-integration.md。
MOGO_DATA_BACKEND=mongo
# PanWeiDB 的连接信息。默认走栈内服务名（backend 网络直连）；
# 要连栈外的实例，改成该实例地址，例如 host.docker.internal。
# PANWEIDB_HOST=panweidb
# PANWEIDB_PORT=5432
# PANWEIDB_USER=boncuser
# PANWEIDB_PASSWORD=
# PANWEIDB_DB=mogo_dev
# PANWEIDB_SCHEMA=mogo_dev
# 宿主端口绑定：默认只绑回环。要让局域网访问改成 0.0.0.0（库的远程认证是
# sha256 口令，绑 0.0.0.0 等于把口令暴露在本机网段，谨慎）。
# MOGO_PANWEIDB_BIND=127.0.0.1
# MOGO_PANWEIDB_PORT=5432

# ── MongoDB / Redis 连接信息（与 panweidb 同一套约定：只改这里，不改 compose）───
# 默认全部指向栈内自带容器（backend 网络的 `mongo` / `redis` 服务名），本地
# `./mogo up` 无需配置。生产用已有的外部库时，把下面几项改成外部地址：
#
#   MOGO_MONGODB_URI=mongodb://mongo:27017        # 可带账号口令、TLS、副本集参数
#   MOGO_MONGODB_DB=mogo_dev
#   MOGO_REDIS_URL=redis://redis:6379/0           # admin-api + document-api/worker
#   MOGO_KERNEL_REDIS_URL=redis://redis:6379/1    # chat-api 的 DSH 锁/归属缓存，独立 DB
#
# 注意 MOGO_KERNEL_REDIS_URL 刻意与 MOGO_REDIS_URL 分开：前者存 DSH 运行时锁和
# session 归属缓存，默认用 DB/1；后者是应用业务缓存（DB/0）。两者混用同一个 DB
# 会让 key 相互覆盖，接外部 Redis 时请保留这个区分。
#
# 要连**栈外**数据库，且本机不再起内部数据库容器时，再开外部模式：
#   MOGO_USE_EXTERNAL_DB=1
# 该开关让 ./mogo up 自动加载 docker-compose.external.yml，把 mongo / redis /
# panweidb 三个容器排除出拓扑（应用仍按上面配置的连接信息连外部实例）。
# 只改连接信息不开关也完全可用：容器会继续跑，应用连的是外部库。
# 起栈前会自动体检一遍连接信息；也可单独跑：./mogo check
#
# 数据源镜像版本同样可覆盖（默认对应仓库里的官方 tag；内网镜像仓库里若换过
# tag，用这几项指过去，与离线 tar 导入互补）：
#   MOGO_MONGO_IMAGE=mongo:8.3.13
#   MOGO_REDIS_IMAGE=redis:7.4.2-alpine
#   MOGO_WEAVIATE_IMAGE=semitechnologies/weaviate:1.25.7
#   MOGO_PANWEIDB_IMAGE=panweidb:3.2.0

# Required only when enabling knowledge-document embedding and reranking.
AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-02-01
AZURE_EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
