
# 平台超级管理员（main_id="__platform__"）：admin-api 启动时幂等 ensure。
# ⚠️ 此文件为本地开发用，已由 .gitignore 排除，不会提交到仓库。
#    生产环境密码必须由部署流程注入，禁止在此处使用静态密码。
ASKAI_ADMIN_PLATFORM_ADMIN_USERNAME=platform
ASKAI_ADMIN_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_LOCAL_DEV_ONLY
ASKAI_ADMIN_PLATFORM_ADMIN_DISPLAY_NAME=平台管理员

# ── 网关 TLS（已启用）────────────────────────────────────────────────
# 指向 TLS 侧网关配置，启用后 HTTP(80) 会 301 到 HTTPS，/healthz 例外。
# 放在 .env 里而不是每次命令行传，是为了让后续 ./mogo up / docker compose up
# 都保持 TLS，不会悄悄退回 HTTP。回退：注释掉这一行再 up -d gateway。
# 证书目录默认 ./deploy/tls（可由 MOGO_TLS_CERTS_DIR 覆盖），私钥需 0644。
MOGO_NGINX_CONF=./deploy/nginx/nginx.conf

#### DSH web 模式 是否开启开关
DSH_WEB_MODE=1
# ── 数据后端：PanWeiDB（MongoDB → PanWeiDB 迁移）────────────────────────
MOGO_DATA_BACKEND=mongo
# 2026-10-13 切换到 PanWeiDB。回滚：把 MOGO_DATA_BACKEND 改回 mongo 再
# docker compose up -d admin-api chat-api document-api document-worker。
# 2026-10-15：重置 panweidb 账号——删除旧 boncuser/boncuser2，新建 boncuser（密码见本文件）。
# 注意：openGauss 3.2.0 的 MD5 为自有误差，与 psycopg/psql 原生不兼容，仅 gsql 可直连；
# Python 服务（chat-api 等）要真正连上需接入 openGauss 兼容驱动，而非原生 psycopg。
PANWEIDB_HOST=host.docker.internal
PANWEIDB_PORT=5432
PANWEIDB_USER=boncuser
PANWEIDB_PASSWORD=JCpolbfHiyimCVlquFd3
PANWEIDB_DB=bonc
PANWEIDB_SCHEMA=mogo_dev
