# 项目配置文件
# 注意：以下是常见的配置文件，但请根据您的项目实际情况决定是否忽略
# 有些配置文件（如 requirements.txt, pyproject.toml, package.json）通常需要提交
services/admin-api/data/knowledge-documents/knowledge-documents/*
services/admin-api/data/admin-static/
services/chat-api/storage/
services/chat-api/dsh/storage/
services/chat-api/dsh/runtime-host.log
apps/official-website/docs/.vitepress/cache/
outputs/*

# DSH agent 工具目录（本地工作区缓存，不入库）
.workbuddy/

# WorkBuddy AI 工作区数据目录（本地记忆/会话数据，不入库）
.workbuddy-ai/

# 待确认清单里的本地排查残留（仅本机产生，不入库）
docs/pending-review/.mogo_tmp_ocr.swift
docs/pending-review/DeepSeek-Harness-store-20260929/

# DSH runtime host local state (per-session storage, not source)
services/chat-api/dsh/runtime-host/storage/
# DSH runtime host ephemeral host-profile (cordis.yml) written beside the install root
services/chat-api/dsh/runtime-host/host-profile-home/

# agent team metadata
.agent-teams/

# Docling offline model bundle (regenerated by scripts/docling_models_bundle.sh save)
# docling-models-bundle.tar.gz is tracked as a <1KB placeholder; save
# the real ~485MB bundle locally with scripts/docling_models_bundle.sh save
# (git add -f the placeholder only; the real bundle is build-context only).

# Playwright offline browser bundle (regenerated by scripts/playwright_browsers_bundle.sh).
# Same contract as the docling bundle above: the <1KB placeholder is tracked
# (git add -f), the real ~290MB bundle is local build-context only. The durable
# browser cache lives under base-images/playwright/ (ignored via /base-images/).
services/chat-api/playwright-browsers-bundle.tar.gz

# pip wheel bundle for document-parser (regenerated by scripts/pip_wheels_bundle.sh save).
# Same contract as the two bundles above: the <1KB placeholder is tracked
# (git add -f), the real multi-hundred-MB bundle is local build-context only.
# The durable per-architecture wheel cache lives under base-images/pip-wheels/
# (ignored via /base-images/).
services/document-parser/pip-wheels-bundle.tar.gz

# Derived requirement split (requirements-wheels.txt / requirements-sdist.txt),
# regenerated by scripts/pip_wheels_bundle.sh on every fetch.
services/document-parser/.pip-wheels-staging/

# 编辑过程的中间备份（ppt/doc/xls 等），不属于产物
*.bak-*
*.bak-before-*

# QualityForge 本地 QA 审计产物（测试项数据、报告、注入脚本）
# 这些是本机审计运行生成的中间产物（audit.json 约 1.1MB），不入库。
.qualityforge/

# 误操作产生的 shell 重定向垃圾文件（pip install 未加引号的 ">" 被 shell 解析）
services/document-parser/=*

# QA 审计的 pytest 临时根（本仓审计需 --basetemp 指向工作区内，
# 否则沙箱下 LOGNAME/USER 不一致会让 basetemp 落到不可创建的位置）
.pytest-tmp*/

# QA 审计检测器的一次性输出（发布链路 / 包级可达性 / 自证式测试）
.r5-*.json

# apt package bundles (regenerated by scripts/apt_packages_bundle.sh save).
# Same contract as the pip / docling / playwright bundles: the <1KB
# placeholder is tracked (git add -f), the real multi-hundred-MB bundle is
# local build-context only. The durable per-arch cache lives under
# base-images/apt/ (ignored via /base-images/).
services/document-parser/apt-packages-bundle.tar.gz
services/chat-api/apt-packages-bundle.tar.gz
