#!/usr/bin/env bash
# 022 FR-26 (T048)：pre-commit 钩子 —— 提交前阻止密钥进入版本库。
#
# 启用方式（一次性）：
#   git config core.hooksPath .githooks
#
# 紧急绕过（仅限本地，不推荐）：
#   SKIP_SECRETS_CHECK=1 git commit ...
#   —— 绕过不会被记录，所以请同时走 docs/security/RESIDUAL_RISK.md 登记。
#
# 注：钩子只检查本次提交涉及的文件（HEAD^..HEAD 或工作区），速度可控；
# 全量扫描在 CI 里跑（scripts/check-secrets.sh --all），避免漏网。

if [[ -n "${SKIP_SECRETS_CHECK:-}" ]]; then
  echo "⚠  SKIP_SECRETS_CHECK 已设置，跳过密钥检查（请走 RESIDUAL_RISK.md 登记）"
  exit 0
fi

# 钩子在仓库根目录执行；从任意子目录提交时定位脚本。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHECK="$SCRIPT_DIR/scripts/check-secrets.sh"

if [[ ! -x "$CHECK" ]]; then
  echo "⚠  $CHECK 不存在或不可执行，跳过密钥检查"
  exit 0
fi

# 本次提交涉及的文件（新提交时 HEAD 仍是上一版，用 --cached 更准）。
files="$(git diff --name-only --cached --diff-filter=ACM)"
if [[ -z "$files" ]]; then
  exit 0
fi

echo "→ 检查提交中的密钥模式..."
while IFS= read -r f; do
  [[ -n "$f" ]] && "$CHECK" "$f" || exit 1
done <<< "$files"

echo "✓ 密钥检查通过"

# ── 治理门禁：只检查本次暂存的 .py（--staged），纯 stdlib、毫秒级 ──────────
# 057 T013：pg_compat 聚合管道阶段白名单（防止写入 PanWeiDB 不支持的 $unwind 等）
# 059 T013：fail-open 反模式扫描（except→return True / db is None→allow / mode=off→allow）
# 两者均支持 `# fail-open-exempt: <理由>` 行内豁免；CI 里跑全量版本。
SCAN_DIR="$SCRIPT_DIR/scripts"
if [[ -f "$SCAN_DIR/check_pg_compat_pipeline_stages.py" ]]; then
  echo "→ 检查暂存文件中的聚合管道阶段（057）..."
  (cd "$SCRIPT_DIR" && python3 "$SCAN_DIR/check_pg_compat_pipeline_stages.py" --staged) || exit 1
fi
if [[ -f "$SCAN_DIR/check_fail_open_patterns.py" ]]; then
  echo "→ 检查暂存文件中的 fail-open 反模式（059）..."
  (cd "$SCRIPT_DIR" && python3 "$SCAN_DIR/check_fail_open_patterns.py" --staged) || exit 1
fi
# 058 T009：拦截新增的 uuid4().hex 实体主键（存量走基线，替换后 --update-baseline）
if [[ -f "$SCAN_DIR/check_uuid_hex_usage.py" ]]; then
  echo "→ 检查暂存文件中的无序主键用法（058）..."
  (cd "$SCRIPT_DIR" && python3 "$SCAN_DIR/check_uuid_hex_usage.py" --staged) || exit 1
fi

echo "✓ 治理门禁检查通过"
exit 0
