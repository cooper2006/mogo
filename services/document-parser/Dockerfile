# Base image by name, not digest: the digest form forces a registry manifest
# lookup even when the image is already present locally, which fails outright
# on an air-gapped or registry-restricted host. Pin by tag and let the local
# image win; override BASE_IMAGE to pin a digest when reproducible pulls matter.
ARG BASE_IMAGE=python:3.10-slim-bookworm
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PROGRESS_BAR=off \
    PIP_NO_CACHE_DIR=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    DOCLING_ARTIFACTS_PATH=/opt/docling/models \
    MOVO_DOC_PROCESSING_LIBREOFFICE_BIN=/usr/bin/libreoffice

WORKDIR /app

ARG INSTALL_SYSTEM_DEPS_AT_BUILD=true
ARG INSTALL_PYTHON_DEPS_AT_BUILD=true
ARG PYTORCH_ACCELERATOR=cpu
# PyTorch CPU wheels: default to a domestic mirror. download.pytorch.org is
# unreachable/slow from CN networks, and the CPU build only exists there (PyPI
# ships the CUDA build), so this is the one index that cannot fall back to the
# PyPI mirror. Override with PYTORCH_CPU_INDEX_URL to point anywhere else.
ARG PYTORCH_CPU_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cpu
ARG PYTORCH_CUDA_INDEX_URL=
ARG MOVO_APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
ARG MOVO_APT_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security
ARG MOVO_PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
COPY scripts /tmp/document-parser-scripts
RUN if [ -n "${MOVO_APT_MIRROR}" ]; then \
        for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
            if [ -f "${source_file}" ]; then \
                sed -i "s|http://deb.debian.org/debian|${MOVO_APT_MIRROR}|g; s|https://deb.debian.org/debian|${MOVO_APT_MIRROR}|g" "${source_file}"; \
                if [ -n "${MOVO_APT_SECURITY_MIRROR}" ]; then \
                    sed -i "s|http://deb.debian.org/debian-security|${MOVO_APT_SECURITY_MIRROR}|g; s|https://deb.debian.org/debian-security|${MOVO_APT_SECURITY_MIRROR}|g; s|http://security.debian.org/debian-security|${MOVO_APT_SECURITY_MIRROR}|g; s|https://security.debian.org/debian-security|${MOVO_APT_SECURITY_MIRROR}|g" "${source_file}"; \
                fi; \
            fi; \
        done; \
    fi \
    && if [ -n "${MOVO_PYPI_INDEX_URL}" ]; then \
        python -m pip config set global.index-url "${MOVO_PYPI_INDEX_URL}"; \
    fi
RUN if [ "${INSTALL_SYSTEM_DEPS_AT_BUILD}" = "true" ]; then \
        unset XZ_DEFAULTS XZ_OPT \
        && rm -f /etc/apt/apt.conf.d/docker-clean \
        && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
        && apt-get install -y --no-install-recommends \
            ca-certificates \
            curl \
            fontconfig \
            fonts-wqy-zenhei \
            fonts-noto-cjk \
            libgl1 \
            libglib2.0-0 \
            libgomp1 \
            libreoffice-core \
            libreoffice-common \
            libreoffice-writer \
            libreoffice-calc \
            libreoffice-impress \
        && rm -rf /var/lib/apt/lists/*; \
    else \
        echo "Skip apt system dependencies in build stage (INSTALL_SYSTEM_DEPS_AT_BUILD=false)"; \
    fi

COPY requirements.txt /tmp/requirements.txt
COPY requirements-docling.txt /tmp/requirements-docling.txt

# Offline pip wheel bundle: `pip-wheels-bundle.tar.gz` in the build context
# (services/document-parser/), a tar.gz whose top level is one directory per
# architecture (<arch>/<wheel files>). Generated by
# `scripts/pip_wheels_bundle.sh save` and cached durably under
# base-images/pip-wheels/.
#
# Why: this stage installs ~120 wheels (torch alone is 152MB on arm64, 196MB on
# amd64) and PIP_NO_CACHE_DIR=1 below makes every build re-download all of
# them. Measured cold cost was ~65s for the torch leg alone even on a fast home
# link, and nothing is shared between an amd64 and an arm64 host.
#
# buildkit resolves COPY at parse time, so that file must exist in the
# context: git ships a <1KB empty-tar placeholder (tracked), and `save`
# overwrites it in place with the real bundle. The RUN below sizes it to
# decide: real bundle -> install from it offline; placeholder -> network.
COPY pip-wheels-bundle.tar.gz /tmp/pip-wheels-bundle.tar.gz

# Target architecture for the wheel directory. BuildKit sets TARGETARCH (amd64
# / arm64); the ARG default keeps a plain `docker build` (no buildx) working,
# where TARGETARCH is empty and the builder is the host.
ARG TARGETARCH
ARG PIP_OFFLINE_INSTALL=true
ARG PYTORCH_CPU_FIND_LINKS=
RUN if [ "${INSTALL_PYTHON_DEPS_AT_BUILD}" = "true" ]; then \
        wheel_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
        offline=false; \
        if [ "${PIP_OFFLINE_INSTALL}" = "true" ] \
            && [ "$(du -sb /tmp/pip-wheels-bundle.tar.gz | cut -f1)" -gt 1024 ]; then \
            mkdir -p /tmp/pip-wheels \
            && tar -xzf /tmp/pip-wheels-bundle.tar.gz -C /tmp/pip-wheels \
            && if [ -d "/tmp/pip-wheels/${wheel_arch}" ]; then \
                   offline=true; \
                   echo "Installing pip wheels offline for ${wheel_arch} ($(find /tmp/pip-wheels/${wheel_arch} -name '*.whl' | wc -l) wheels)"; \
               else \
                   echo "Bundle has no ${wheel_arch}/ directory; falling back to the network."; \
               fi; \
        else \
            echo "Skip offline wheel bundle (placeholder or PIP_OFFLINE_INSTALL=false); using the network."; \
        fi; \
        rm -f /tmp/pip-wheels-bundle.tar.gz; \
        offline_args=""; \
        if [ "${offline}" = "true" ]; then \
            offline_args="--no-index --find-links=/tmp/pip-wheels/${wheel_arch}"; \
        fi; \
        python -m pip install --progress-bar off \
            ${offline_args} \
            --upgrade pip setuptools wheel \
        && case "${PYTORCH_ACCELERATOR}" in \
            cpu) \
                if [ "${offline}" = "true" ]; then \
                    python -m pip install --progress-bar off --no-index \
                        --find-links=/tmp/pip-wheels/${wheel_arch} \
                        "torch>=2.2.2,<3.0.0" "torchvision>=0,<1"; \
                elif [ -n "${PYTORCH_CPU_FIND_LINKS}" ]; then \
                    python -m pip install --progress-bar off --find-links "${PYTORCH_CPU_FIND_LINKS}" "torch>=2.2.2,<3.0.0" "torchvision>=0,<1"; \
                else \
                    python -m pip install --progress-bar off --index-url "${PYTORCH_CPU_INDEX_URL}" "torch>=2.2.2,<3.0.0" "torchvision>=0,<1"; \
                fi ;; \
            cu128|cu130) \
                python -m pip install --progress-bar off --index-url "${PYTORCH_CUDA_INDEX_URL:-https://mirror.sjtu.edu.cn/pytorch-wheels/${PYTORCH_ACCELERATOR}}" "torch>=2.2.2,<3.0.0" "torchvision>=0,<1" ;; \
            default) \
                echo "Skip PyTorch preinstall (PYTORCH_ACCELERATOR=default)" ;; \
            *) \
                echo "Unsupported PYTORCH_ACCELERATOR=${PYTORCH_ACCELERATOR}" >&2; exit 2 ;; \
        esac \
        && python -m pip install --progress-bar off ${offline_args} --require-hashes -r /tmp/requirements.txt \
        && python -m pip install --progress-bar off ${offline_args} --prefer-binary -r /tmp/requirements-docling.txt \
        && python -m pip uninstall --yes pip wheel \
        && find /usr/local/lib/python3.10/ensurepip/_bundled -type f -delete \
        && rm -rf /tmp/pip-wheels; \
    else \
        echo "Skip Python dependencies in build stage (INSTALL_PYTHON_DEPS_AT_BUILD=false)"; \
        rm -f /tmp/pip-wheels-bundle.tar.gz; \
    fi \
    && python -c "from docling.document_converter import DocumentConverter; print('docling ok')" \
    && python -c "import torch; print(f'torch {torch.__version__}, cuda_available={torch.cuda.is_available()}, cuda={torch.version.cuda}')"

ARG INSTALL_DOCLING_MODELS_AT_BUILD=true
# Only used when the offline model bundle is absent (placeholder): points the
# HuggingFace client at a domestic mirror instead of huggingface.co.
ARG MOVO_HF_ENDPOINT=https://hf-mirror.com
ARG MOVO_HF_TIMEOUT=120
# Offline model bundle: `docling-models-bundle.tar.gz` in the build context
# (services/document-parser/), a tar.gz laid out exactly as /opt/docling/models
# would be. Generated by `scripts/docling_models_bundle.sh save`.
# buildkit resolves COPY at parse time, so that file must exist in the
# context: git ships a <1KB empty-tar placeholder (tracked), and `save`
# overwrites it in place with the real ~485MB bundle for offline builds.
# The RUN below sizes it to decide: real bundle -> extract offline (skips the
# slow ~265s HuggingFace fetch); placeholder -> fall back to online download.
COPY docling-models-bundle.tar.gz /tmp/docling-models-bundle.tar.gz
RUN if [ "${INSTALL_DOCLING_MODELS_AT_BUILD}" = "true" ]; then \
        if [ "$(du -sb /tmp/docling-models-bundle.tar.gz | cut -f1)" -gt 1024 ]; then \
            echo "Installing Docling models from offline bundle" \
            && mkdir -p "${DOCLING_ARTIFACTS_PATH}" \
            && tar -xzf /tmp/docling-models-bundle.tar.gz -C "${DOCLING_ARTIFACTS_PATH}" \
            && rm -f /tmp/docling-models-bundle.tar.gz \
            && HF_HUB_OFFLINE=1 python /tmp/document-parser-scripts/verify_docling_runtime.py; \
        else \
            echo "Skip offline bundle (placeholder); downloading Docling models from HuggingFace."; \
            rm -f /tmp/docling-models-bundle.tar.gz; \
            if [ -n "${MOVO_HF_ENDPOINT}" ]; then export HF_ENDPOINT="${MOVO_HF_ENDPOINT}"; fi; \
            HF_HUB_DISABLE_XET=1 HF_HUB_ETAG_TIMEOUT="${MOVO_HF_TIMEOUT}" HF_HUB_DOWNLOAD_TIMEOUT="${MOVO_HF_TIMEOUT}" \
                python /tmp/document-parser-scripts/download_docling_models.py \
            && HF_HUB_OFFLINE=1 python /tmp/document-parser-scripts/verify_docling_runtime.py; \
        fi; \
    else \
        echo "Skip Docling model download and verification (INSTALL_DOCLING_MODELS_AT_BUILD=false)"; \
        rm -f /tmp/docling-models-bundle.tar.gz; \
    fi

# Security refresh is opt-in. A non-empty value (CI passes its run id) applies
# the latest distro security patches; an empty or "false" value skips the
# upgrade, which keeps this layer cacheable so a local rebuild does not
# re-download every package.
ARG MOVO_SECURITY_REFRESH=
RUN if [ -n "${MOVO_SECURITY_REFRESH}" ] && [ "${MOVO_SECURITY_REFRESH}" != "false" ]; then \
        apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
        && apt-get upgrade -y \
        && rm -rf /var/lib/apt/lists/*; \
    else \
        echo "Skip apt upgrade (set MOVO_SECURITY_REFRESH to apply security patches)"; \
    fi

ENV HF_HUB_OFFLINE=1

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

COPY app /app/app
COPY .env.example /app/.env.example
# Ensure in-container permissions do not depend on host file modes, so the
# COPY layer stays cacheable across host permission churn.
RUN chmod -R a+rX /app

EXPOSE 8200

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["api"]
