# Required for direct source development. Docker deployment generates these.
# 品牌归一（movo→mogo）：示例统一使用规范前缀 MOGO_DOC_PROCESSING_。
# 旧前缀 MOVO_DOC_PROCESSING_（及更早的 ASKAI_DOC_PROCESSING_）在过渡期仍被接受；
# 同名键同时存在时 MOGO_ 优先。
MOGO_DOC_PROCESSING_SERVICE_TOKEN=
MOGO_DOC_PROCESSING_CALLBACK_TOKEN=
MOGO_DOC_PROCESSING_LOCAL_STORAGE_DIR=../admin-api/data/knowledge-documents
MOGO_DOC_PROCESSING_ARTIFACTS_PREFIX=artifacts
MOGO_DOC_PROCESSING_LIBREOFFICE_BIN=
MOGO_DOC_PROCESSING_CONVERSION_TIMEOUT_SECONDS=180
MOGO_DOC_PROCESSING_REDIS_URL=redis://127.0.0.1:6379/0
MOGO_DOC_PROCESSING_CELERY_QUEUE=document_processing
MOGO_DOC_PROCESSING_MONGODB_URI=mongodb://127.0.0.1:27017
MOGO_DOC_PROCESSING_MONGODB_DB=mogo_dev
# ── 数据后端开关（MongoDB → PanWeiDB 迁移）──────────────────────────────
# 留空或 mongo = 行为不变；panweidb = 走 openGauss 内核 / PostgreSQL 兼容线协议。
# 完整说明见 docs/mongo-to-panweidb-migration-plan.md。
MOGO_DATA_BACKEND=mongo
PANWEIDB_HOST=127.0.0.1
PANWEIDB_PORT=5432
PANWEIDB_USER=boncuser
PANWEIDB_PASSWORD=
PANWEIDB_DB=mogo_dev
PANWEIDB_SCHEMA=mogo_dev
PANWEIDB_POOL_MIN_SIZE=1
PANWEIDB_POOL_MAX_SIZE=10
MOGO_DOC_PROCESSING_JOBS_COLLECTION=document_jobs
MOGO_DOC_PROCESSING_OSS_ACCESS_KEY_ID=
MOGO_DOC_PROCESSING_OSS_ACCESS_KEY_SECRET=
MOGO_DOC_PROCESSING_AZURE_EMBEDDING_ENDPOINT=https://your-resource.openai.azure.com/
MOGO_DOC_PROCESSING_AZURE_EMBEDDING_DEPLOYMENT_NAME=text_embedding
MOGO_DOC_PROCESSING_AZURE_EMBEDDING_API_VERSION=2025-04-01-preview
MOGO_DOC_PROCESSING_AZURE_EMBEDDING_API_KEY=
MOGO_DOC_PROCESSING_WEAVIATE_ENDPOINT=http://127.0.0.1:8080
MOGO_DOC_PROCESSING_WEAVIATE_API_KEY=
MOGO_DOC_PROCESSING_WEAVIATE_COLLECTION_NAME=AskAIKnowledgeChunks
MOGO_DOC_PROCESSING_WEAVIATE_DISTANCE_METRIC=cosine
MOGO_DOC_PROCESSING_DASHSCOPE_API_KEY=
MOGO_DOC_PROCESSING_ADMIN_JWT_SECRET=
