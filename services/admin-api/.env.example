ASKAI_ADMIN_APP_ENV=development
ASKAI_ADMIN_MONGODB_URI=mongodb://127.0.0.1:27017
ASKAI_ADMIN_MONGODB_DB=mogo_dev
# ── 数据后端开关（MongoDB → PanWeiDB 迁移）──────────────────────────────
# 留空或 mongo = 行为不变；panweidb = 走 openGauss 内核 / PostgreSQL 兼容线协议。
# 完整说明见 docs/mongo-to-panweidb-migration-plan.md。
MOGO_DATA_BACKEND=mongo
PANWEIDB_HOST=127.0.0.1
PANWEIDB_PORT=5432
PANWEIDB_USER=boncuser
PANWEIDB_PASSWORD=
PANWEIDB_DB=mogo_dev
PANWEIDB_SCHEMA=mogo_dev
# 生产应指向独立 schema，以获得独立的备份/权限/生命周期（022 FR-17 的 PG 侧等价物）。
PANWEIDB_AUDIT_SCHEMA=
PANWEIDB_POOL_MIN_SIZE=1
PANWEIDB_POOL_MAX_SIZE=10
# Required for direct source development. Docker deployment generates this.
ASKAI_ADMIN_JWT_SECRET=
ASKAI_ADMIN_BACKEND_BASE_URL=http://127.0.0.1:8000
ASKAI_ADMIN_BACKEND_SERVICE_TOKEN=
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_ENABLED=false
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_USERNAME=admin
# Set only when explicitly enabling bootstrap administration for local development.
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_PASSWORD=
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_ROLE_NAME=租户管理员
ASKAI_ADMIN_TENANT_BOOTSTRAP_ADMIN_ORG_NAME=MOGO 平台
# Platform super-admin (decisions 1/5/19). An existing deployment that already
# completed the setup wizard MUST set PASSWORD here, otherwise there is no way
# into the platform console after upgrade. Leave blank to use the /setup wizard.
ASKAI_ADMIN_PLATFORM_ADMIN_USERNAME=
ASKAI_ADMIN_PLATFORM_ADMIN_PASSWORD=
ASKAI_ADMIN_PLATFORM_ADMIN_DISPLAY_NAME=平台超级管理员
ASKAI_ADMIN_MODEL_TEST_CA_BUNDLE=
ASKAI_ADMIN_MODEL_TEST_INSECURE_SKIP_VERIFY=false
ASKAI_ADMIN_KNOWLEDGE_STORAGE_TYPE=local
ASKAI_ADMIN_KNOWLEDGE_LOCAL_STORAGE_DIR=data/knowledge-documents
ASKAI_ADMIN_KNOWLEDGE_MAX_UPLOAD_MB=200
ASKAI_ADMIN_KNOWLEDGE_OSS_ACCESS_KEY_ID=
ASKAI_ADMIN_KNOWLEDGE_OSS_ACCESS_KEY_SECRET=
ASKAI_ADMIN_KNOWLEDGE_OSS_PREFIX=knowledge-documents
ASKAI_ADMIN_DOCUMENT_PROCESSING_BASE_URL=http://127.0.0.1:8200
ASKAI_ADMIN_DOCUMENT_PROCESSING_SERVICE_TOKEN=
ASKAI_ADMIN_DOCUMENT_PROCESSING_CALLBACK_TOKEN=
ASKAI_ADMIN_ADMIN_API_PUBLIC_BASE_URL=http://127.0.0.1:8100
