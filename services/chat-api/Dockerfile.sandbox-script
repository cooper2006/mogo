FROM node:22-bookworm-slim AS node-runtime

FROM python:3.15-slim-bookworm

ARG MOGO_PIP_INDEX_URL=
ARG MOGO_APT_MIRROR=
ENV PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_PROGRESS_BAR=off
WORKDIR /app

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && if [ -n "${MOGO_APT_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org/debian-security|${MOGO_APT_MIRROR%/}/debian-security|g; s|http://deb.debian.org/debian|${MOGO_APT_MIRROR%/}/debian|g" /etc/apt/sources.list.d/debian.sources; \
    fi

# The sandbox script itself only uses the standard library (it shells out to
# pip / npm / apt-get to install whatever a Skill declares), so this image
# does NOT need the chat-api dependency closure. Installing it here was both
# slow and, once the closure moved to Python 3.13, impossible on this 3.10
# base image (numpy>=2.5 requires >=3.12). What the image actually needs is a
# working pip and a working apt, so those are all that get installed.
#
# pip's vendored CA bundle does not know the TLS-terminating proxy's root CA,
# so pip needs a bundle that includes it. See the longer note in
# services/sandbox-manager/Dockerfile; the file is mounted (not COPYed) and
# follows the same bundle contract -- run `bash scripts/proxy_ca_bundle.sh
# pack` once after cloning.
ARG TARGETARCH
RUN --mount=type=bind,source=proxy-root.crt,target=/tmp/proxy-root.crt \
    set -eux; \
    pip_cert_args=""; \
    if [ -s /tmp/proxy-root.crt ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /tmp/proxy-root.crt > /tmp/combined-ca.crt; \
        pip_cert_args="--cert /tmp/combined-ca.crt"; \
        echo "Using system CA bundle plus the proxy root for pip"; \
    else \
        echo "No proxy root CA in the build context; pip uses its own bundle."; \
    fi; \
    python -m pip install --no-cache-dir --upgrade ${pip_cert_args} pip setuptools wheel; \
    rm -f /tmp/combined-ca.crt
RUN ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

COPY sandbox_script /opt/mogo-sandbox
